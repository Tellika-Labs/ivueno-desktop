{
  "name": "ivueno-desktop",
  "productName": "Ivueno",
  "version": "0.1.0",
  "private": true,
  "description": "Ivueno desktop: records a meeting on your own computer (no bot in the call) and writes the notes",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "dist": "vite build && electron-builder --win nsis",
    "dist:mac": "vite build && electron-builder --mac",
    "icons:mac": "electron scripts/render-mac-icons.js"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.0.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.0.0",
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.0.12",
    "rcedit": "4.0.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "ao.ivueno.desktop",
    "productName": "Ivueno",
    "publish": [
      {
        "provider": "generic",
        "url": "https://2-29-200-22.sslip.io/downloads/"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "src/preload/**",
      "src/shared/**",
      "dist/**",
      "assets/**",
      "!assets/models/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "node_modules/ffmpeg-static/**",
      "src/main/voices-worker.js",
      "node_modules/sherpa-onnx-darwin-arm64/**",
      "node_modules/sherpa-onnx-darwin-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "artifactName": "Ivueno-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeaderIcon": "assets/app-icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/uninstaller-sidebar.bmp",
      "language": "2070",
      "shortcutName": "Ivueno",
      "installerHeader": "assets/installer-header.bmp",
      "include": "scripts/installer.nsh"
    },
    "afterPack": "scripts/installer-hooks.js",
    "afterAllArtifactBuild": "scripts/installer-hooks.js",
    "extraResources": [
      {
        "from": "assets/models",
        "to": "models",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ivueno uses the microphone to record your meetings and write the notes.",
        "NSAudioCaptureUsageDescription": "Ivueno records the computer's sound so it can hear the other people in the meeting.",
        "LSMinimumSystemVersion": "13.0"
      },
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Ivueno ${version}"
    }
  }
}
